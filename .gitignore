# ── Editor / tooling ──────────────────────────────────────────────────────────
.claude/

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.egg-info/
.pytest_cache/

# ── Data ──────────────────────────────────────────────────────────────────────
# Everything under datasets/ arrives via the Zenodo deposit or is built locally.
# See docs/DATA.md.
datasets/
data/
data_caches/
datasets_unpublished/
logs/
tmp_af3_missing/

# Symlinks to large machine-local trees (scripts/link_external.sh).
external/

# Upstream checkouts of the comparison methods. Clone each repository
# yourself; see docs/REPRODUCING_ANALYSES.md.
external_methods/

# ── Generated output ──────────────────────────────────────────────────────────
# results/ holds full runs; results_quick/ holds the notebook's QUICK mode.
/results/
/results_quick/
figures/*.png
figures/*.tex
brca1/
brca1_extra/

# ── Model weights ─────────────────────────────────────────────────────────────
# Checkpoints are distributed via Zenodo. Only the two files that variant-DB
# inference loads are tracked, so a clone can run the inference quickstart.
weights/**/*.pt
weights/**/*.pkl
!weights/MutPred-PPI.pt
!weights/mutation_diff_scaler.pkl

# ── Superseded content, kept on disk for provenance ───────────────────────────
archive/

# ── Scratch ───────────────────────────────────────────────────────────────────
repro_test/
*.tar.gz
*.log

# ── Manuscript sources and internal working notes ─────────────────────────────
main*.tex
supplement*.tex
ANALYSIS_STATUS.md
REPRODUCIBILITY.md
ZENODO_CHECKLIST.md
docs/ZENODO_MANIFEST.md
docs/METHOD_PROVENANCE.md
docs/FIGURE_INVENTORY.md
zenodo/
