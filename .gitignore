logs/

# Raw and derived VarChAMP data (unpublished, local only)
data/

# Training + inference datasets (VarChAMP unpublished; SF/Sahni CSVs documented as Zenodo downloads)
datasets/

# Internal documents (LaTeX source, analysis tracking, ad hoc run scripts)
main.tex
supplement.tex
ANALYSIS_STATUS.md
REPRODUCIBILITY.md
# Root-anchored: these are the ad hoc drivers at the repo root.  Unanchored,
